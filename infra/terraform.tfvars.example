# Copy to terraform.tfvars locally; never commit credentials or real state.
subscription_id          = "REPLACE_WITH_SUBSCRIPTION_ID"
tenant_id                = "REPLACE_WITH_TENANT_ID"
ssh_public_key_path      = "C:/Users/YOUR_USER/.ssh/id_ed25519.pub"
api_authorized_ip_ranges = ["203.0.113.10/32"] # Replace with your real trusted public IP.
node_count               = 2
node_vm_size             = "Standard_D4s_v4"
acr_name                 = "REPLACE_WITH_UNIQUE_ACR_NAME"
resource_group_name      = "purely-demo-rg"
cluster_name             = "purely-demo-aks"
network_name_prefix      = "purely-demo"
log_analytics_name       = "purely-demo-logs"
location                 = "eastus"
log_daily_quota_gb       = 1
