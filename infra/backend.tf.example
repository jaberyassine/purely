# Enable only after locating the existing authoritative state and preparing
# remote storage. Do not initialize an empty state against existing AKS.
terraform {
  backend "azurerm" {
    resource_group_name  = "REPLACE_STATE_RESOURCE_GROUP"
    storage_account_name = "REPLACE_STATE_STORAGE_ACCOUNT"
    container_name       = "tfstate"
    key                  = "purely.terraform.tfstate"
    use_azuread_auth     = true
  }
}
